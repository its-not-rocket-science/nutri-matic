# Copy to .env (same directory as docker-compose.yml) and fill in.
# .env is gitignored; never commit real values. docker compose reads this
# file to fill the ${VAR} references in docker-compose.yml.

# Required. Signs login tokens. At least 32 characters; the backend refuses
# to start with a shorter one, and compose refuses to start without one.
# Generate:  python -c "import secrets; print(secrets.token_hex(32))"
# Use a different value on every machine; never reuse the production one.
JWT_SECRET=

# Frontend origin(s) allowed to call the API, comma-separated.
CORS_ORIGINS=http://localhost:5173

# Optional. Number of reverse-proxy hops in front of the API (0 locally).
TRUSTED_PROXY_HOP_COUNT=0

# Optional. Shared secret for GET /api/ready/licence-policy-coverage.
# Leave empty to keep that endpoint closed.
OPS_DIAGNOSTIC_TOKEN=

# Compose defaults to production. Locally, development skips the
# production-only startup checks and tags any Sentry events "development".
APP_ENV=development

# Optional locally; set on the server. Backend Sentry DSN. Leave empty to
# disable backend monitoring (production then logs one startup ERROR).
SENTRY_DSN=

# Set automatically by the deploy workflow; leave empty locally.
RELEASE_VERSION=
