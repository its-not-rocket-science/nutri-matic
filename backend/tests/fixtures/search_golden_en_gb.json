     "must_not_in_top5": ["spirals"], "right_food": "zucchini|courgette"},
    {"n": "14", "query": "coriander", "before": "ok",
     "top1": {"fdc_ids": [169997]}, "right_food": "coriander|cilantro"},
    {"n": "15", "query": "cilantro", "before": "ok",
     "top1": {"fdc_ids": [169997]}, "right_food": "coriander|cilantro"},
    {"n": "16", "query": "rocket", "before": "wrong",
