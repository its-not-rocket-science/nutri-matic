{
  "_about": [
    "Golden en-GB food-search queries: the 34 queries from docs/plans/canonical-foods-plan.md section 1.2.",
    "before: the plan's verdict for the old ranking on the full catalogue (ok = sensible generic, branded = right food but branded/US product, wrong = wrong food).",
    "top1: what the top result must be. fdc_ids (any of), and/or name_regex plus generic (generic = Foundation/SR Legacy).",
    "state: expected preparation state of the top result. note: expected synonym note on the top result.",
    "must_not_in_top5: case-insensitive regexes that no top-5 name may match.",
    "right_food: case-insensitive regex used by the full-catalogue report to tell 'right food but branded' from 'wrong food'.",
    "known_gap: the catalogue has no sensible generic row for this query; the test checks only must_not_in_top5."
  ],
  "locale": "en-GB",
  "queries": [
    {"n": "1", "query": "chickpeas", "before": "ok",
     "top1": {"fdc_ids": [173800, 173801, 2644288]}, "state": "canned_drained",
     "right_food": "chick ?peas?|garbanzo"},
    {"n": "2", "query": "canned chickpeas", "before": "wrong",
     "top1": {"fdc_ids": [173800, 173801, 2644288]}, "state": "canned_drained",
     "must_not_in_top5": ["chicken", "pate"], "right_food": "chick ?peas?|garbanzo"},
    {"n": "3", "query": "dried chickpeas", "before": "wrong",
     "top1": {"fdc_ids": [2644282, 173756]}, "state": "dry",
     "must_not_in_top5": ["chia"], "right_food": "chick ?peas?|garbanzo"},
    {"n": "4", "query": "lentils", "before": "ok",
     "top1": {"fdc_ids": [2644283, 172420, 174284]}, "state": "dry",
     "right_food": "lentil"},
    {"n": "5", "query": "porridge oats", "before": "branded",
     "top1": {"fdc_ids": [2346396, 173904]}, "state": "dry",
     "right_food": "oats"},
    {"n": "6", "query": "semi-skimmed milk", "before": "wrong",
     "top1": {"name_regex": "^milk, reduced fat, fluid, 2% milkfat", "generic": true},
     "note": "approx. UK semi-skimmed",
     "must_not_in_top5": ["skim milk", "nonfat", "cottage", "evaporated"],
     "right_food": "2%.*milk|milk.*2%|semi.?skimmed"},
    {"n": "7", "query": "wholemeal bread", "before": "wrong",
     "top1": {"fdc_ids": [335240, 172688, 172690]},
     "must_not_in_top5": ["bread mix"],
     "right_food": "bread, whole-wheat|whole ?(meal|wheat|grain) bread"},
    {"n": "8", "query": "mince", "before": "wrong",
     "top1": {"name_regex": "^beef, (grass-fed, )?ground, .*raw", "generic": true}, "state": "raw",
     "must_not_in_top5": ["pie", "ham, minced"],
     "right_food": "beef, ground|ground beef|beef mince|minced beef"},
    {"n": "9", "query": "beef mince", "before": "wrong",
     "top1": {"name_regex": "^beef, (grass-fed, )?ground, .*raw", "generic": true}, "state": "raw",
     "must_not_in_top5": ["ground beef patties"],
     "right_food": "beef, ground|ground beef|beef mince|minced beef"},
    {"n": "10", "query": "aubergine", "before": "wrong",
     "top1": {"fdc_ids": [2685577, 169228]}, "state": "raw",
     "must_not_in_top5": ["dip"], "right_food": "eggplant|aubergine"},
    {"n": "11", "query": "eggplant", "before": "ok",
