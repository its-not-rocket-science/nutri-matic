     "must_not_in_top5": ["kfc", "crispy", "chocolate crisps"],
     "right_food": "potato chips|potato crisps"},
    {"n": "22", "query": "chips", "before": "wrong",
     "top1": {"name_regex": "french fr", "generic": true},
     "must_not_in_top5": ["taro", "banana", "bagel", "pita"],
     "right_food": "french fr|\\bfries\\b"},
    {"n": "23", "query": "biscuit", "before": "wrong",
     "top1": {"fdc_ids": [171867]},
     "must_not_in_top5": ["^biscuits, plain or buttermilk"],
     "right_food": "cookie|digestive|shortbread"},
    {"n": "24", "query": "jam", "before": "ok",
     "top1": {"fdc_ids": [169641]}, "right_food": "\\bjams?\\b|preserves"},
    {"n": "25", "query": "double cream", "before": "wrong",
     "top1": {"fdc_ids": [2346386, 170859]},
     "note": "UK double cream (~48% fat) is richer than US heavy cream (~36%)",
     "must_not_in_top5": ["brie", "cremont"],
     "right_food": "heavy (whipping )?cream|cream, (fluid, )?heavy"},
    {"n": "26", "query": "plain flour", "before": "branded",
     "top1": {"name_regex": "^(wheat flour, white|flour, wheat), all-purpose, (?!self)", "generic": true},
     "must_not_in_top5": ["potato"],
