    {"n": "28", "query": "tinned tomatoes", "before": "branded",
     "top1": {"name_regex": "^tomatoes, .*canned", "generic": true}, "state": "canned_with_liquid",
     "must_not_in_top5": ["^tomato juice"],
     "right_food": "tomatoes"},
    {"n": "29", "query": "baked beans", "before": "branded",
     "top1": {"fdc_ids": [175182]}, "note": "approx. UK baked beans",
     "right_food": "baked beans|beans, baked"},
    {"n": "30", "query": "cheddar", "before": "ok",
     "top1": {"fdc_ids": [328637, 173414]}, "right_food": "cheddar"},
    {"n": "x1", "query": "porridge", "before": "wrong",
     "top1": {"fdc_ids": [173905, 171675]}, "state": "cooked_boiled",
     "right_food": "oats?.*cooked|porridge oats|oatmeal"},
    {"n": "x2", "query": "houmous", "before": "wrong",
     "top1": {"fdc_ids": [321358, 174289, 172454]},
     "must_not_in_top5": ["kombucha"], "right_food": "hummus|houmous|hommous"},
    {"n": "x3", "query": "rapeseed oil", "before": "wrong",
