     "right_food": "^(oil, canola|.*\\b(canola|rapeseed) oil)$"},
    {"n": "x4", "query": "kidney beans", "before": "branded",
     "top1": {"fdc_ids": [174285, 175243, 2644289, 2644290]}, "state": "canned_drained",
     "right_food": "kidney beans|beans, kidney"}
  ]
}
