		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^5.7.2",
		"vite": "^6.0.7",
		"vitest": "^4.1.10"
	},
	"dependencies": {
		"@sentry/sveltekit": "^10.68.0",
		"@zxing/browser": "^0.1.5",
		"@zxing/library": "^0.21.3"
	}
