		"svelte": "^5.56.1",
		"svelte-check": "^4.7.8",
		"typescript": "^7.0.2",
		"vite": "^8.3.7",
		"vitest": "^5.1.0"
	},
	"dependencies": {
		"@sentry/sveltekit": "^11.11.0",
		"@zxing/browser": "^0.2.1",
		"@zxing/library": "^0.23.0"
	}
