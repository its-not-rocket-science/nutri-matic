		"svelte-check": "^4.7.8",
		"typescript": "^7.0.2",
		"vite": "^6.4.6",
		"vitest": "^5.1.0"
	},
	"dependencies": {
		"@sentry/sveltekit": "^10.78.0",
		"@zxing/browser": "^0.2.1",
		"@zxing/library": "^0.23.0"
	}
